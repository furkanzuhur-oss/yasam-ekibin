# UCRETSIZ Google Gemini API anahtari (kredi karti gerekmez):
#   https://aistudio.google.com/apikey adresinden "Create API key" deyin.
GEMINI_API_KEY=AIza...

# Modeller (Gemini ucretsiz katmaninda calisir)
AGENT_MODEL=gemini-2.5-flash
ROUTER_MODEL=gemini-2.5-flash-lite

# (OPSIYONEL) Daha kaliteli internet aramasi icin ucretsiz Tavily anahtari.
# Bos birakirsaniz arama yine calisir (Wikipedia + DuckDuckGo, anahtarsiz).
# Ucretsiz anahtar (kredi karti gerekmez): https://app.tavily.com
# TAVILY_API_KEY=tvly-...

# Bulut veritabani (Firebase Firestore) servis hesabi.
# Bos birakilirsa veriler yerel data/ klasorunde tutulur (gelistirme icin).
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Inen JSON dosyasini base64'e cevirip tek satir olarak buraya yapistir:
#   (PowerShell)  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
# FIREBASE_SERVICE_ACCOUNT_B64=ey...base64...
# (Alternatif: ham JSON'u tek satir olarak FIREBASE_SERVICE_ACCOUNT='{...}' seklinde de verebilirsin.)

# Sunucu portu
PORT=3000
